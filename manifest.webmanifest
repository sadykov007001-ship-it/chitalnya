{
  "name": "Читальня",
  "short_name": "Читальня",
  "description": "Личная читалка: EPUB, FB2, PDF, MOBI, DJVU и другие форматы, выделения и заметки",
  "lang": "ru",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14171a",
  "theme_color": "#14171a",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": {
      "application/epub+zip": [".epub"], "application/x-fictionbook+xml": [".fb2"], "application/pdf": [".pdf"],
      "application/x-mobipocket-ebook": [".mobi", ".azw", ".azw3"], "image/vnd.djvu": [".djvu"],
      "text/plain": [".txt"], "application/rtf": [".rtf"], "application/vnd.comicbook+zip": [".cbz"]
    } }
  ]
}
